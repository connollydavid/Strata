# Strata server (qwen3.8-flash-next UD-IQ4_XS v3.1 + Q8_0 engram, 4 slots
# x 524288, int8 KV, YaRN 2) — the plan/0154 big-bang line: engine 0.1.59,
# Unsloth Dynamic v3.1 UD-IQ4_XS main shards with the Q8_0 engram table,
# conversation cache 30208/4. NOT enabled at boot while llama-server
# remains the boot default (plan/0150 phase order);
# scripts/model-swap.sh decides which engine stands. The two engines are
# GPU-exclusive (call/0006): never run both at once.
#
# Versioned copy of /etc/systemd/system/strata.service (paths point at the
# recipe's worktree, software/strata/yarn-audited-line).
[Unit]
Description=Strata server (qwen3.8-flash-next ud-iq4xs-q8ple 4x524288 int8-kv yarn2)
After=network.target

[Service]
Type=simple
User=dconnolly
WorkingDirectory=/home/dconnolly/yarn-agentic/software/strata/yarn-audited-line
ExecStart=/home/dconnolly/yarn-agentic/software/strata/yarn-audited-line/run-ud_v31_iq4xs.sh
# The engine page-locks ~50 GiB of expert RAM for GPU access.
LimitMEMLOCK=infinity
LimitNOFILE=65536
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
